# ===== AutoCut — backend local =====
# Copie este arquivo para `server/.env` e preencha. NUNCA comite o .env real.
# A chave de API vive SÓ aqui, no backend — o painel UXP nunca a vê.

# Porta/host do backend. Mantém-se em 127.0.0.1 (só acesso local) no MVP.
HOST=127.0.0.1
PORT=7867

# Token de autenticação — DEIXE VAZIO em uso local.
# Só preencher quando o backend for hospedado (aí o painel passa no header Authorization).
AUTH_TOKEN=

# Idioma padrão da transcrição.
LANGUAGE=pt

# Motor de transcrição: "whisperx" (local, offline, default), "openai" (API) ou
# "elevenlabs" (Scribe v2 na nuvem — literal pro corte, limpo pra legenda; v2 do AutoCut).
TRANSCRIBER=whisperx

# --- WhisperX (local) ---
# Binário do venv dedicado. Por padrão reaproveita o do skill vsl-editor.
WHISPERX_BIN=/Users/SEU_USUARIO/.claude/skills/vsl-editor/.venv-whisperx/bin/whisperx
WHISPERX_MODEL=large-v3
WHISPERX_ALIGN_MODEL=jonatasgrosman/wav2vec2-large-xlsr-53-portuguese
WHISPERX_DEVICE=cpu
WHISPERX_COMPUTE_TYPE=int8
WHISPERX_BATCH_SIZE=8

# --- OpenAI Whisper (usado SÓ se TRANSCRIBER=openai) ---
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1

# --- ElevenLabs Scribe v2 (usado SÓ se TRANSCRIBER=elevenlabs) ---
# A CHAVE NÃO VAI AQUI: é lida do Keychain do macOS. Crie a entrada uma vez com:
#   security add-generic-password -s elevenlabs-api-key -a "$USER" -w
# (a chave precisa de permissão de Speech to Text). Nome do serviço, se for outro:
ELEVENLABS_KEYCHAIN_SERVICE=elevenlabs-api-key
ELEVENLABS_MODEL=scribe_v2
# Banco de grafias como keyterms (1 termo por linha). Vazio = desligado (padrão; +20% no custo
# e ainda sem teste em vídeo fora do nicho — ver services/transcription/elevenlabsScribe.ts).
ELEVENLABS_KEYTERMS_FILE=
# Marca risada/aplauso/música (sem custo; o AutoCut ainda não usa os eventos). 0 desliga.
ELEVENLABS_AUDIO_EVENTS=1
# Pasta pra guardar a resposta crua de cada transcrição (auditoria). Vazio = não guarda.
ELEVENLABS_RAW_DIR=
ELEVENLABS_TIMEOUT_SEC=1800

# --- Claude (módulo 2 — análise dos cortes) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
