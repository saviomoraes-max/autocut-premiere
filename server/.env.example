# ===== AutoCut — backend local =====
# Copie este arquivo para `server/.env` e preencha. NUNCA comite o .env real.
# A chave de API vive SÓ aqui, no backend — o painel UXP nunca a vê.

# Porta/host do backend. Mantém-se em 127.0.0.1 (só acesso local) no MVP.
HOST=127.0.0.1
PORT=7867

# Token de autenticação — DEIXE VAZIO em uso local.
# Só preencher quando o backend for hospedado (aí o painel passa no header Authorization).
AUTH_TOKEN=

# Idioma padrão da transcrição.
LANGUAGE=pt

# Motor de transcrição: "whisperx" (local, offline, default) ou "openai" (API).
TRANSCRIBER=whisperx

# --- WhisperX (local) ---
# Binário do venv dedicado. Por padrão reaproveita o do skill vsl-editor.
WHISPERX_BIN=/Users/SEU_USUARIO/.claude/skills/vsl-editor/.venv-whisperx/bin/whisperx
WHISPERX_MODEL=large-v3
WHISPERX_ALIGN_MODEL=jonatasgrosman/wav2vec2-large-xlsr-53-portuguese
WHISPERX_DEVICE=cpu
WHISPERX_COMPUTE_TYPE=int8
WHISPERX_BATCH_SIZE=8

# --- OpenAI Whisper (usado SÓ se TRANSCRIBER=openai) ---
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1

# --- Claude (módulo 2 — análise dos cortes) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
